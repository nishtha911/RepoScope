{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/staging-login",
      "destination": "https://reposcope-staging.onrender.com/api/repos/33"
    },
    {
      "source": "/api/:path*",
      "destination": "https://reposcope-staging.onrender.com/api/:path*"
    }
  ]
}
